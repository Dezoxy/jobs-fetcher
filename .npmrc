# Resolve only versions published at least 7 days ago (npm >= 11.17; Renovate's
# npm is pinned via renovate.json constraints). Applies when a lock file is
# (re)generated, e.g. Renovate lock file maintenance; `npm ci` installs the
# lock file as is. Mirrors Renovate's minimumReleaseAge for transitive deps.
min-release-age=7
